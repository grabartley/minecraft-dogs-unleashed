accessWidener v2 named

# Widen RegistryEntry$Reference#setRegistryKey so SimpleRegistry can call it from outside its
# package when Bootstrap.initialize() runs in a plain unit-test JVM. Yarn-mapped RegistryEntry
# leaves this package-private, and JUnit's classloader enforces that strictly. Dev runs such as
# runClient and runGametest do not need this entry, because Fabric Loader's PackageAccessFixer
# widens package-private Minecraft members whenever the runtime namespace is `named`. The plain
# JUnit JVM does not run through Knot and has no such transformer. See MinecraftBootstrapExtension.
accessible	method	net/minecraft/registry/entry/RegistryEntry$Reference	setRegistryKey	(Lnet/minecraft/registry/RegistryKey;)V
# Widen MobEntity#goalSelector so gametests can assert which goal a dog is actually running,
# rather than inferring its behaviour from where the entity ended up. See DogCombatBehaviorGameTest.
accessible	field	net/minecraft/entity/mob/MobEntity	goalSelector	Lnet/minecraft/entity/ai/goal/GoalSelector;
